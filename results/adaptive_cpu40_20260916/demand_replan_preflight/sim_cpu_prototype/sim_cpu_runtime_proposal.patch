+// Invoke once from the actual executor thread, not from its creator. No marker
+// is emitted for pooled workers whose execution thread is not known here.
+inline void reportThreadRole(const char *role) noexcept {
+    if (!enabled()) {
+        return;
+    }
+#if defined(__linux__) && defined(SYS_gettid)
+    const long tid = syscall(SYS_gettid);
+    if (tid <= 0) {
+        return;
+    }
+    std::fprintf(stderr,
+            "[THREAD_CPU_ROLE] version=1 pid=%ld tid=%ld role=%s\n",
+            static_cast<long>(getpid()), tid, role ? role : "unspecified");
+#else
+    (void)role;  // Do not invent a TID on unsupported platforms.
+#endif
+}
